{
	"name": "@subako-ai/react",
	"version": "0.2.0",
	"description": "React bindings for Subako sessions and client tools",
	"homepage": "https://subako.ai",
	"license": "Apache-2.0",
	"author": "Kikuvi, Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/subako-ai/subako-sdk-typescript.git",
		"directory": "packages/react"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./package.json": "./package.json"
		},
		"access": "public"
	},
	"scripts": {
		"prepack": "node ../../scripts/prepack.mjs"
	},
	"devDependencies": {
		"@subako-ai/sdk": "workspace:*",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"happy-dom": "^20.14.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^7"
	},
	"peerDependencies": {
		"@subako-ai/sdk": "workspace:^",
		"react": "^19.0.0"
	},
	"engines": {
		"node": ">=22"
	}
}
