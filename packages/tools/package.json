{
	"name": "@subako-ai/tools",
	"version": "0.2.10",
	"description": "Tools that let a Subako agent drive the page: forms, navigation, and a reader for an existing form",
	"homepage": "https://subako.ai",
	"license": "Apache-2.0",
	"author": "Kikuvi, Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/subako-ai/subako-sdk-typescript.git",
		"directory": "packages/tools"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
