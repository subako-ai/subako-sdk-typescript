	},
	"scripts": {
		"prepack": "node ../../scripts/prepack.mjs"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@subako-ai/sdk": "workspace:*",
		"happy-dom": "^21.0.4",
		"typescript": "^7",
		"zod": "^4.6.6"
	},
	"peerDependencies": {
		"@subako-ai/sdk": "workspace:^"
	},
	"engines": {
		"node": ">=22"
	}
}
